FROM postgres:15

# Install build dependencies for pgsodium
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    libssl-dev \
    libsodium-dev \
    postgresql-server-dev-15 \
    && rm -rf /var/lib/apt/lists/*

# Clone and build pgsodium
RUN cd /tmp && \
    git clone https://github.com/michelp/pgsodium.git && \
    cd pgsodium && \
    make && \
    make install

# Clean up build dependencies
RUN apt-get remove -y build-essential git postgresql-server-dev-15 && \
    apt-get autoremove -y && \
    rm -rf /tmp/pgsodium

# Copy initialization script
COPY init-extensions.sql /docker-entrypoint-initdb.d/00-init-extensions.sql
